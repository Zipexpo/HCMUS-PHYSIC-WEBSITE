# ── Stack env (copy to the REPO ROOT as .env) ────────────────────────────────
# docker compose -f docker-compose.sandbox.yml reads this for variable substitution.
# Replace <SERVER_IP> with the sandbox public IP (e.g. 103.88.122.23).

# Local Postgres (created by the db service)
POSTGRES_USER=physics
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hcmus_physics

# PUBLIC base URL of the backend API — BAKED INTO the Next builds, so the
# browser (and the public/admin containers) must be able to reach it.
# Use the sandbox's public IP (or a domain if you set one up).
NEXT_PUBLIC_API_URL=http://<SERVER_IP>:3001
