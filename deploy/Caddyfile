phys.hcmus.edu.vn {
	encode gzip zstd
	# API backend dưới tiền tố /be (KHÔNG dùng /api vì trang public có route /api/og, /api/revalidate riêng)
	handle_path /be/* {
		reverse_proxy backend:3001
	}
	# Ảnh/tệp tải lên (kể cả link /uploads thô trong nội dung legacy)
	handle /uploads/* {
		reverse_proxy backend:3001
	}
	# Hệ phiếu hỗ trợ — ứng dụng RIÊNG, chạy dưới /ho-tro trên cùng tên miền để
	# khỏi phải xin thêm bản ghi DNS. Dùng `handle` (không phải handle_path) vì
	# Next bên đó đặt basePath=/ho-tro, nó cần nguyên tiền tố.
	# Phải liệt kê CẢ `/ho-tro` trần lẫn `/ho-tro/*`: mẫu có `/*` KHÔNG khớp
	# đường trần, nên nó rơi xuống trang công khai, trang đó thêm tiền tố ngôn
	# ngữ thành /vi/ho-tro rồi trả 404.
	@ho_tro path /ho-tro /ho-tro/*
	handle @ho_tro {
		reverse_proxy ticket:3003
	}

	# Nhiều người quen gõ /vi/... nên đưa về đúng chỗ thay vì để gặp 404.
	# Nhiều người quen gõ /vi/... nên đưa về đúng chỗ thay vì để gặp 404.
	# Dùng regex để CẮT tiền tố ngôn ngữ. KHÔNG dùng {uri} — biến đó là toàn bộ
	# đường dẫn gốc, ghép vào sẽ ra /ho-tro/vi/ho-tro/...
	@ho_tro_locale path_regexp hotro ^/(?:vi|en)(/ho-tro.*)$
	redir @ho_tro_locale {re.hotro.1} permanent

	# Còn lại → trang công khai (Next.js)
	handle {
		reverse_proxy public:3002
	}
}

# Trang quản trị qua HTTPS trên cổng 3000 (app tự chuyển / → /admin). Container
# admin KHÔNG map cổng 3000 trên host nữa — Caddy giữ cổng đó và proxy nội bộ.
phys.hcmus.edu.vn:3000 {
	reverse_proxy admin:3000
}

# Dự phòng: cổng 8443 cũng vào admin (phòng khi cần).
phys.hcmus.edu.vn:8443 {
	reverse_proxy admin:3000
}
